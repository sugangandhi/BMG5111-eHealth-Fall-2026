# ==============================================================================
# eHospital & Smart Health Backend Configuration
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# OpenAI API Key (Required for GPT-4o Clinical Triage & Whisper Voice Scribe)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# AWS App Runner Remote Services (Pre-configured defaults)
EHOSPITAL_BASE_URL=https://aetab8pjmb.us-east-1.awsapprunner.com
EHOSPITAL_AUTH_BASE_URL=https://tysnx3mi2s.us-east-1.awsapprunner.com
CENTRAL_CLINICAL_API_URL=https://aetab8pjmb.us-east-1.awsapprunner.com

# Server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
ASSISTANT_PROVIDER=wearable_langgraph

# Optional WhatsApp Cloud API Webhook configuration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
