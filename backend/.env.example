# e-Hospital Platform - Environment Configuration

# ── Meta WhatsApp Verified Business API ──────────────────────────────────────
# The API key / Permanent Access Token provided for the project:
WHATSAPP_TOKEN=your_meta_system_user_access_token_here

# The WhatsApp Phone Number ID from the Meta Developer App Dashboard:
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Secret token you enter in Meta Webhook configuration:
WHATSAPP_VERIFY_TOKEN=ehospital_verified_2026

# ── Central Clinical EMR Cloud Network ──────────────────────────────────────
# AWS App Runner live MySQL introspected database endpoint:
CENTRAL_CLINICAL_API_URL=https://aetab8pjmb.us-east-1.awsapprunner.com

# ── AI Model Configuration ───────────────────────────────────────────────────
# Local Ollama endpoint (default: http://localhost:11434/v1):
LOCAL_AI_URL=http://localhost:11434/v1
